PORT=3000
NODE_ENV=production
# العنوان العام للموقع (يُشفَّر داخل QR)
BASE_URL=https://your-site.onrender.com
# بريد الدكتور الوحيد المسموح له بالدخول
DOCTOR_EMAIL=abuhijleh@najah.edu
# حسابات إضافية مسموحة (مفصولة بفواصل) تدخل لوحة الدكتور نفسها
EXTRA_ALLOWED_EMAILS=fayezghaith123@gmail.com
# مسار قاعدة البيانات (على Render: داخل القرص الدائم)
DB_PATH=/data/attendance.db
LATE_AFTER_MINUTES=0
# اختياري: إن تُرك فارغًا يُولَّد سر آمن تلقائيًا ويُحفظ في القاعدة
JWT_SECRET=

# ===== البريد (اختر واحدًا) =====
# الخيار 1: Brevo عبر HTTPS (يُنصح به على الاستضافات التي تحجب SMTP)
BREVO_API_KEY=
MAIL_FROM=
# الخيار 2: SMTP عادي (مثل Gmail مع App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
