PORT=3000
NODE_ENV=production
# قاعدة البيانات: رابط Supabase (Session pooler، منفذ 5432) أو أي PostgreSQL محلي
DATABASE_URL=postgresql://attendance_app.PROJECT_REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
LATE_AFTER_MINUTES=0
# اختياري: إن تُرك فارغًا يُولَّد سر آمن تلقائيًا ويُحفظ في القاعدة
JWT_SECRET=

# ===== البريد (اختر واحدًا) =====
# الخيار الأسهل: EmailJS (يرسل من Gmail) — انظر DEPLOY.md
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# أو: Google Apps Script: Google Apps Script يرسل من Gmail — انظر mail-relay.gs و DEPLOY.md
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_SECRET=
# الخيار 1: Brevo عبر HTTPS (يُنصح به على الاستضافات التي تحجب SMTP)
BREVO_API_KEY=
MAIL_FROM=
# الخيار 2: SMTP عادي (مثل Gmail مع App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
